<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Lets FlipFix switch its own accessibility service on only while the phone is folded,
      so banking apps on the main screen never see it. Granted once from a PC:
        adb shell pm grant io.github.avengerdeveloper.flipfix android.permission.WRITE_SECURE_SETTINGS
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <queries>
        <package android:name="com.samsung.android.spay" />
        <!-- Samsung's AOD app holds the cover clock fonts; FlipFix loads them from there at runtime. -->
        <package android:name="com.samsung.android.app.aodservice" />
        <!-- Lets FlipFix load the small notification icons of the apps that post notifications. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <!-- The one-time "Pause FlipFix for <banking app>?" question. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The unlocked cover face. Launched on the cover display by CoverAccessibilityService. -->
        <activity
            android:name=".CoverActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:taskAffinity="io.github.avengerdeveloper.flipfix.cover"
            android:theme="@style/Theme.FlipFix.Cover" />

        <service
            android:name=".CoverAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/flipfix_accessibility" />
        </service>

        <!-- Quick Settings tile to switch FlipFix on/off. -->
        <service
            android:name=".FlipFixTileService"
            android:exported="true"
            android:icon="@drawable/ic_flipfix"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Buttons of the banking-app question notification. -->
        <receiver
            android:name=".BankGuardReceiver"
            android:exported="false" />

        <!-- Always bound by the system: watches fold state and feeds notification icons and media. -->
        <service
            android:name=".FlipNotificationListener"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
