<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Glass stand-ins for the widgets under Samsung's clock; see CoverWidgetGlass. -->
    <io.github.avengerdeveloper.flipfix.CoverWidgetGlass
        android:id="@+id/glass"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Matches Samsung's cover lock-screen clock line; see CoverClockStyle. -->
    <io.github.avengerdeveloper.flipfix.CoverClockView
        android:id="@+id/clock"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Notification icons (top-left) and battery pill (top-right); see CoverStatusView. -->
    <io.github.avengerdeveloper.flipfix.CoverStatusView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Music pill (bottom-left) with working controls; see CoverMediaView. -->
    <io.github.avengerdeveloper.flipfix.CoverMediaView
        android:id="@+id/media"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
