<?xml version="1.0" encoding="utf-8"?>
<!--
  Only window-state changes, no window content: FlipFix never reads what is on screen.
  Gestures: taps that land on FlipFix's edge strip are replayed to Samsung's widgets underneath.
  Screenshot: only of the cover screen, only of FlipFix's own face at the moment it is swiped away, kept in
  memory for the slide-away / slide-back animation. Never saved or sent anywhere.
  The service exists so FlipFix may open its cover face from the background after unlock.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canPerformGestures="true"
    android:canTakeScreenshot="true"
    android:canRetrieveWindowContent="false"
    android:description="@string/a11y_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="0" />
